CREATE TABLE review (
    review_id TEXT PRIMARY KEY,
    book_isbn VARCHAR(255) NOT NULL,
    reviewer_email TEXT NOT NULL,
    headline TEXT NOT NULL,
    body TEXT NOT NULL,
    rating INTEGER NOT NULL CHECK (rating BETWEEN 1 AND 5),
